# PostgreSQL (Pflicht fuer das Bewertungsskript)
POSTGRES_USER=chat_user
POSTGRES_PASSWORD=super_secret_postgres_pw
POSTGRES_DB=chat_db

# RabbitMQ
RABBITMQ_USER=chat_user
RABBITMQ_PASSWORD=rabbit_password

# batch-writer: Nachrichten pro Batch und Transaktion (Bewertung 1, S4)
BATCH_SIZE=100

# Live-Zustellung (Bewertung 2)
# Gesamtlimit der Live-Queue: ready + unacknowledged bleibt darunter (S6).
LIVE_QUEUE_MAX_LENGTH=1000
# Nachrichten in flight; wird vom Gesamtlimit abgezogen, weil eine pausierte
# Instanz nicht ackt und list_queues messages beides zaehlt.
LIVE_QUEUE_PREFETCH=10
# Heartbeats aus: eine beliebig lange Pause darf die exclusive Queue nicht loeschen.
RABBITMQ_REQUESTED_HEARTBEAT=0
# Kurzes DB-Timeout, damit Nachholen bei gestoppter Datenbank schnell 503 gibt.
DB_CONNECTION_TIMEOUT_MS=3000