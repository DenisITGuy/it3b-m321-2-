<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Der Root erbt von Spring Boot, damit alle Module die gleichen Versionen nutzen -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.10</version>
        <relativePath/>
    </parent>

    <groupId>ch.it3b</groupId>
    <artifactId>it3b-m321</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>it3b-m321-parent</name>

    <modules>
        <module>backend</module>
        <module>batch-writer</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Testcontainers 1.19.8 spricht Docker-API 1.32; neuere Engines lehnen das ab -->
        <testcontainers.version>1.21.3</testcontainers.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- docker-java sendet ohne diese Angabe API 1.32. Docker Engine 29
                             verlangt mindestens 1.40 und antwortet sonst mit HTTP 400,
                             wodurch Testcontainers keine Test-Container starten kann.
                             1.41 liegt im gueltigen Bereich von Engine 20.10 bis 29,
                             damit mvn clean test auf jedem Rechner gruen laeuft (S1). -->
                        <argLine>-Dapi.version=1.41</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>